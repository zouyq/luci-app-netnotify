config netnotify 'main'
	option enable '0'
	option device_name 'OpenWrt'
	option channel 'webhook'
	option webhook_url ''
	option suspect_timeout_sec '60'
	option probe_max_parallel '2'
	option offline_fail_count '3'
	option sleeptime '30'
	option debug '0'
	option oui_enable '1'
	option oui_path '/usr/share/netnotify/oui_base.txt'
	option bark_sound 'silence.caf'
	option bark_level 'active'
	option qywx_touser '@all'
	option crontab ''
	option interval_time '6'
	option send_title '路由状态'
	option cron_devices '1'
	option cron_status '1'
	option notify_list_enable '1'
	option notify_list_max '15'
	option netcheck_enable '0'
	option netcheck_interval_sec '300'
	option netcheck_timeout_sec '2'
	option netcheck_retry '2'
	option netcheck_retry_interval_sec '1'
	option netcheck_wan_iface 'wan'
	option netcheck_startup_wait_sec '120'
	option netcheck_cooldown_sec '600'
	option netcheck_recover_wait_sec '120'
	option netcheck_push_on_recover '1'
	list netcheck_hosts 'connect.rom.miui.com'
	list netcheck_hosts 'connectivitycheck.vivo.com.cn'
	list netcheck_hosts 'connectivitycheck.platform.hicloud.com'
	list netcheck_hosts 'conn1.oppomobile.com'
	list netcheck_ips '223.5.5.5'
	list netcheck_ips '119.29.29.29'
	# list aliases 'aa:bb:cc:dd:ee:ff=手机'
	# list whitelist 'aa:bb:cc:dd:ee:ff'
	# list blacklist '11:22:33:44:55:66'
	# list watch_ifaces 'br-lan'
